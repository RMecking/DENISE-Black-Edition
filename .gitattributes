# Auto detect text files and perform LF normalization
* text=auto

# Keep tracked shell scripts directly executable in Linux and WSL checkouts.
*.sh text eol=lf

# Custom for Visual Studio
*.cs     diff=csharp

# Standard to msysgit
*.doc	 diff=astextplain
*.DOC	 diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot  diff=astextplain
*.DOT  diff=astextplain
*.pdf  diff=astextplain
*.PDF	 diff=astextplain
*.rtf	 diff=astextplain
*.RTF	 diff=astextplain

# Retained M5 provenance artifacts are hashed byte-for-byte by the test suite.
# Preserve repository bytes on Windows/WSL checkouts instead of translating EOLs.
tests/m5*.patch -text
tests/m5*.json  -text

# M6.3b provenance artifacts are hashed byte-for-byte by the test suite.
tests/m6.3b_visco_sh_fwi_attenuation_validation.json text eol=lf
docs/m6.3_visco_sh_fwi_attenuation_audit.md text eol=lf
tests/utilities/m63b_production_adjoint_instrumentation.py text eol=lf
